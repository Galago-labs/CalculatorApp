<Window x:Class="CalculatorApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Calculator" Height="600" Width="320"
        Background="#1e1e1e" WindowStyle="SingleBorderWindow"
        ResizeMode="CanMinimize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Memory Indicator and Display -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0">
            <TextBlock Name="MemoryIndicator" Text="M" Visibility="Collapsed" 
                       Foreground="#FF9500" FontSize="14" FontWeight="Bold" 
                       VerticalAlignment="Center" Margin="0,0,10,0"/>
        </StackPanel>
        
        <!-- Display -->
        <TextBox Name="ResultBox" Grid.Row="0" 
                 FontSize="48" Background="#1e1e1e"
                 Foreground="White" BorderThickness="0" 
                 IsReadOnly="True" Text="0"
                 HorizontalContentAlignment="Right" 
                 VerticalContentAlignment="Bottom"
                 Height="100" Padding="0,0,10,10"/>

        <!-- Buttons Grid -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- Row 0 -->
            <Button Content="C" Click="Clear_Click" Style="{StaticResource CalcFunction}" Grid.Row="0" Grid.Column="0"/>
            <Button Content="⌫" Click="Backspace_Click" Style="{StaticResource CalcFunction}" Grid.Row="0" Grid.Column="1"/>
            <Button Content="%" Click="Append_Click" Style="{StaticResource CalcFunction}" Grid.Row="0" Grid.Column="2"/>
            <Button Content="÷" Click="Append_Click" Style="{StaticResource CalcOperator}" Grid.Row="0" Grid.Column="3"/>

            <!-- Row 1 -->
            <Button Content="7" Click="Append_Click" Style="{StaticResource CalcButton}" Grid.Row="1" Grid.Column="0"/>
            <Button Content="8" Click="Append_Click" Style="{StaticResource CalcButton}" Grid.Row="1" Grid.Column="1"/>
            <Button Content="9" Click="Append_Click" Style="{StaticResource CalcButton}" Grid.Row="1" Grid.Column="2"/>
            <Button Content="×" Click="Append_Click" Style="{StaticResource CalcOperator}" Grid.Row="1" Grid.Column="3"/>

            <!-- Row 2 -->
            <Button Content="4" Click="Append_Click" Style="{StaticResource CalcButton}" Grid.Row="2" Grid.Column="0"/>
            <Button Content="5" Click="Append_Click" Style="{StaticResource CalcButton}" Grid.Row="2" Grid.Column="1"/>
            <Button Content="6" Click="Append_Click" Style="{StaticResource CalcButton}" Grid.Row="2" Grid.Column="2"/>
            <Button Content="-" Click="Append_Click" Style="{StaticResource CalcOperator}" Grid.Row="2" Grid.Column="3"/>

            <!-- Row 3 -->
            <Button Content="1" Click="Append_Click" Style="{StaticResource CalcButton}" Grid.Row="3" Grid.Column="0"/>
            <Button Content="2" Click="Append_Click" Style="{StaticResource CalcButton}" Grid.Row="3" Grid.Column="1"/>
            <Button Content="3" Click="Append_Click" Style="{StaticResource CalcButton}" Grid.Row="3" Grid.Column="2"/>
            <Button Content="+" Click="Append_Click" Style="{StaticResource CalcOperator}" Grid.Row="3" Grid.Column="3" Grid.RowSpan="2"/>

            <!-- Row 4 -->
            <Button Content="0" Click="Append_Click" Style="{StaticResource CalcZero}" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"/>
            <Button Content="." Click="Append_Click" Style="{StaticResource CalcButton}" Grid.Row="4" Grid.Column="2"/>

            <!-- Row 5 -->
            <Button Content="√" Click="Append_Click" Style="{StaticResource CalcFunction}" Grid.Row="5" Grid.Column="0"/>
            <Button Content="^" Click="Append_Click" Style="{StaticResource CalcFunction}" Grid.Row="5" Grid.Column="1"/>
            <Button Content="±" Click="ToggleSign_Click" Style="{StaticResource CalcFunction}" Grid.Row="5" Grid.Column="2"/>
            <Button Content="=" Click="Equals_Click" Style="{StaticResource CalcEqual}" Grid.Row="5" Grid.Column="3"/>
        </Grid>
    </Grid>
</Window>